<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for EventActivity - displays detailed information about a single event.
    This is a stub layout that will be populated with event details.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/event_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText">

    <!-- Event title and favorite button container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <!-- Event title placeholder -->
        <TextView
            android:id="@+id/event_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Event Title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Favorite toggle button -->
        <ToggleButton
            android:id="@+id/favoriteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:checked="false"
            android:contentDescription="Mark event as favorite"
            android:textOff="☆"
            android:textOn="★"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- Event details placeholder -->
    <TextView
        android:id="@+id/event_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Event details will appear here"
        android:textSize="16sp" />

    <!-- Event description (separate TextView for test matching) -->
    <TextView
        android:id="@+id/event_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:visibility="gone" />

    <!-- Event URL (separate TextView for test matching) -->
    <TextView
        android:id="@+id/event_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:paddingTop="8dp"
        android:visibility="gone" />

</LinearLayout>